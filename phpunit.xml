<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        Test suites by module. Each module suite spans all four test types
        (docs/guides/infra/testing.md §Structure):

          tests/Arch/{Module}/*.php    — Architecture / contract tests
          tests/Unit/{Module}/*.php    — Unit tests (Entity, DTO, Enum, Model)
          tests/Feature/{Module}/*.php — Feature tests (Action, Livewire, Policy)
          tests/Browser/{Module}/*.php — Browser / E2E tests (Node runner, no PHP)

        Build order (docs/specs/index.md §Build Order). All modules are
        registered even when their spec-driven suites are not yet rewritten;
        empty directories simply discover no tests.
    -->
    <testsuites>
        <testsuite name="Core">
            <directory>tests/Arch/Core</directory>
            <directory>tests/Unit/Core</directory>
            <directory>tests/Feature/Core</directory>
            <directory>tests/Browser/Core</directory>
        </testsuite>
        <testsuite name="Setup">
            <directory>tests/Arch/Setup</directory>
            <directory>tests/Unit/Setup</directory>
            <directory>tests/Feature/Setup</directory>
            <directory>tests/Browser/Setup</directory>
        </testsuite>
        <testsuite name="Setting">
            <directory>tests/Arch/Setting</directory>
            <directory>tests/Unit/Setting</directory>
            <directory>tests/Feature/Setting</directory>
            <directory>tests/Browser/Setting</directory>
        </testsuite>
        <testsuite name="Academic">
            <directory>tests/Arch/Academic</directory>
            <directory>tests/Unit/Academic</directory>
            <directory>tests/Feature/Academic</directory>
            <directory>tests/Browser/Academic</directory>
        </testsuite>
        <testsuite name="Auth">
