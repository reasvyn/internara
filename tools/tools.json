{
  "purpose": "Registry of tools/ scanners and the output category each writes to tools/outputs/{YYYYMMDDHHMMSS}-{category}.json. Consumed by clean_outputs.py --prune to keep only the latest timestamped output per category.",
  "version": "2.0.0",
  "features": {
    "caching": "Mtime-based file cache in tools/outputs/cache/",
    "progress": "ProgressReporter for scan operations",
    "parallel": "ThreadPoolExecutor with configurable workers",
    "dedup": "Finding deduplication by file/rule/line",
    "html": "HTML report generation",
    "markdown": "Markdown report generation",
    "diff": "Compare two JSON reports"
  },
  "outputs": {
    "architecture": {
      "script": "scan_architecture.py",
      "description": "Component counts per module, submodule structure"
    },
    "arch-patterns": {
      "script": "scan_arch_patterns.py",
      "description": "Architecture pattern detection"
    },
    "class-contracts": {
      "script": "scan_class_contracts.py",
      "description": "Action/Entity/DTO/Model/Enum contract compliance"
    },
    "conventions": {
      "script": "scan_conventions.py",
      "description": "D1 strict_types, D4 Fillable, D2 debug calls, hardcoded strings"
    },
    "dead-code": {
      "script": "scan_dead_code.py",
      "description": "Unregistered observers, orphan events, unused DTOs/Actions/Jobs"
    },
    "doc-links": {
      "script": "scan_doc_links.py",
      "description": "Broken relative links and anchors in markdown"
    },
    "files": {
      "script": "scan_files.py",
      "description": "File counts and lines of code per module"
    },
    "issues": {
      "script": "scan_issues.py",
      "description": "GitHub issue metrics"
    },
    "module-boundaries": {
      "script": "scan_module_boundaries.py",
      "description": "Module boundary and dependency checks"
    },
    "naming": {
      "script": "scan_naming.py",
      "description": "File and class naming conventions"
    },
    "security": {
      "script": "scan_security.py",
      "description": "XSS, CSP, SQL injection, mass assignment, auth, secrets, CSRF, uploads, rate limiting"
    },
    "spec-tests": {
      "script": "scan_spec_tests.py",
      "description": "Spec↔tests coverage (FR/NFR/UC traceability, non-testable marker)"
    },
    "tests": {
      "script": "scan_tests.py",
      "description": "Test suite pass/fail results"
    },
    "ui-consistency": {
      "script": "scan_ui_consistency.py",
      "description": "UI consistency checks"
    },
    "violations": {
      "script": "scan_violations.py",
      "description": "C1-C8, D1-D6 architecture invariant violations"
    }
  }
}
