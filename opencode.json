{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow",
            ".secrets": "deny",
            "**/.secrets": "deny",
            ".secrets/*": "deny",
            "**/.secrets/*": "deny"
        },
        "bash": {
            "*": "ask",
            "cat *secrets*": "deny",
            "cat *.env*": "deny",
            "cat *\\.env*": "deny",
            "grep *secrets*": "deny",
            "grep *\\.env*": "deny",
            "git *": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git branch*": "allow",
            "composer *": "allow",
            "php artisan *": "allow",
            "vendor/bin/pint *": "allow",
            "vendor/bin/pest *": "allow",
            "vendor/bin/phpstan *": "allow",
            "npm *": "allow",
            "npx prettier*": "allow",
            "python3 scripts/*": "allow",
            "ls *": "allow",
            "cat README.md": "allow",
            "cat AGENTS.md": "allow",
            "cat docs/*": "allow"
        },
        "skill": {
            "*": "allow"
        },
        "task": {
            "*": "allow"
        },
        "external_directory": {
            "~/.ssh/**": "ask",
            "/home/reasvyn/.ssh/**": "ask",
            "/tmp/**": "allow"
        }
    },
    "mcp": {
        "docsgrep": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@anovise/docsgrep"
            ],
            "enabled": true
        },
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "github": {
            "type": "local",
            "command": [
                "bash",
                ".agents/mcp-github-wrapper.sh"
            ],
            "enabled": false
        }
    },
    "agent": {}
}
