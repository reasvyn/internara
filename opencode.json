{
    "$schema": "https://opencode.ai/config.json",
    "small_model": "opencode/nemotron-3.5-lightning-free",
    "compaction": {
        "auto": true,
        "prune": true,
        "tail_turns": 12,
        "preserve_recent_tokens": 8000
    },
    "tool_output": {
        "max_lines": 150,
        "max_bytes": 10240
    },
    "formatter": false,
    "lsp": false,
    "permission": {
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "**/.env": "deny",
            "**/.env.*": "deny",
            ".secrets": "deny",
            "**/.secrets/**": "deny",
            "*.env.example": "allow",
            "**/.ssh/**": "ask",
            "**/.aws/**": "ask",
            "**/.gcp/**": "ask",
            "**/.azure/**": "ask",
            "**/.kube/config": "ask",
            "**/.docker/config.json": "ask",
            "**/.secret": "ask",
            "**/.secret.*": "ask",
            "**/*.secret": "ask",
            "**/*.secrets": "ask",
            "**/secrets/**": "ask",
            "**/credentials.json": "ask",
            "**/*service-account*.json": "ask",
            "**/.npmrc": "ask",
            "**/.pypirc": "ask",
            "**/.netrc": "ask",
            "**/.git-credentials": "ask",
            "**/*.tfvars": "ask",
            "**/*.tfstate": "ask",
            "**/.terraform/**": "ask",
            "**/secrets.yaml": "ask",
            "**/secrets.yml": "ask",
            "**/.vault/**": "ask",
            "**/*.pem": "ask",
            "**/*.key": "ask",
            "**/*.p12": "ask",
            "**/*.pfx": "ask",
            "**/*.jks": "ask",
            "**/id_rsa*": "ask",
            "**/id_ed25519*": "ask",
            "**/.envrc": "ask",
            "**/.bash_history": "ask",
            "**/.zsh_history": "ask",
            "**/.psql_history": "ask"
        },
        "edit": {
            "*": "allow",
            ".env": "deny",
            ".env.*": "deny",
            "*.env": "deny",
            "*.env.*": "deny",
            "**/.env": "deny",
            "**/.env.*": "deny",
            "**/.ssh/**": "ask",
            "**/.aws/**": "ask",
            "**/.gcp/**": "ask",
            "**/.azure/**": "ask",
            "**/.kube/config": "ask",
            "**/.docker/config.json": "ask",
            "**/.secrets/**": "ask",
            "**/.secret": "ask",
            "**/.secret.*": "ask",
            "**/*.secret": "ask",
            "**/*.secrets": "ask",
            "**/secrets/**": "ask",
            "**/credentials.json": "ask",
            "**/*service-account*.json": "ask",
            "**/.npmrc": "ask",
            "**/.pypirc": "ask",
            "**/.netrc": "ask",
            "**/.git-credentials": "ask",
            "**/*.tfvars": "ask",
            "**/*.tfstate": "ask",
            "**/.terraform/**": "ask",
            "**/secrets.yaml": "ask",
            "**/secrets.yml": "ask",
            "**/.vault/**": "ask",
            "**/*.pem": "ask",
            "**/*.key": "ask",
            "**/*.p12": "ask",
            "**/*.pfx": "ask",
            "**/*.jks": "ask",
            "**/id_rsa*": "ask",
            "**/id_ed25519*": "ask",
            "**/.envrc": "ask"
        },
        "glob": {
            "*": "allow",
            "**/.env*": "ask",
            "**/.ssh/**": "ask",
            "**/.aws/**": "ask",
            "**/.secrets/**": "ask",
            "**/*.secret": "ask",
            "**/secrets/**": "ask",
            "**/*.tfvars": "ask",
            "**/*.pem": "ask",
            "**/*.key": "ask"
        },
        "grep": {
            "*": "allow",
            "**/.env*": "ask",
            "**/.ssh/**": "ask",
            "**/.aws/**": "ask",
            "**/.secrets/**": "ask",
            "**/*.secret": "ask",
            "**/secrets/**": "ask",
            "**/.npmrc": "ask",
            "**/.netrc": "ask",
            "**/.git-credentials": "ask",
            "**/*.tfvars": "ask"
        },
        "list": {
            "*": "allow",
            "**/.ssh/**": "ask",
            "**/.aws/**": "ask",
            "**/.gcp/**": "ask",
            "**/.azure/**": "ask",
            "**/.secrets/**": "ask",
            "**/.vault/**": "ask",
            "**/.terraform/**": "ask"
        },
        "bash": {
            "*": "allow",
            "sed -i*": "ask",
            "* sed -i*": "ask",
            "perl -i*": "ask",
            "* perl -i*": "ask",
            "awk -i *": "ask",
            "* awk -i *": "ask",
            "tee *.env*": "ask",
            "tee *secret*": "ask",
            "cat *.env*": "deny",
            "cat *\\.env*": "deny",
            "cat *secret*": "ask",
            "cat *secrets*": "ask",
            "cat **/.ssh/**": "ask",
            "cat ~/.ssh/*": "ask",
            "cat **/*.pem": "ask",
            "cat **/*.key": "ask",
            "echo * > *.env*": "ask",
            "echo * >> *.env*": "ask",
            "echo * > *secret*": "ask",
            "curl *\\.env*": "ask",
            "wget *\\.env*": "ask",
            "sudo *": "deny",
            "sudo -i*": "deny",
            "su *": "deny",
            "rm -rf /": "deny",
            "rm -rf /*": "deny",
            "rm -rf ~/*": "deny",
            "rm -rf ~": "deny",
            "chmod 777 *": "deny",
            "curl *| sh": "deny",
            "curl *|sh": "deny",
            "curl *| bash": "deny",
            "curl *|bash": "deny",
            "wget *| sh": "deny",
            "wget *|sh": "deny",
            "wget *| bash": "deny",
            "wget *|bash": "deny",
            "php artisan migrate:fresh*": "ask",
            "php artisan migrate:fresh --seed*": "ask",
            "php artisan db:wipe*": "ask",
            "git push --force*": "ask",
            "git push -f*": "ask",
            "git *": "allow",
            "composer *": "allow",
            "php artisan *": "allow",
            "vendor/bin/pint *": "allow",
            "vendor/bin/pest *": "allow",
            "vendor/bin/phpstan *": "allow",
            "npm *": "allow",
            "npx prettier*": "allow",
            "python3 scripts/*": "allow",
            "python3 /tmp/*": "allow",
            "ls *": "allow"
        },
        "task": {
            "*": "allow"
        },
        "skill": {
            "*": "allow"
        },
        "external_directory": {
            "/tmp/**": "allow",
            "/home/reasvyn/Workspace/**": "allow",
            "~/.ssh/**": "ask",
            "/home/reasvyn/.ssh/**": "ask",
            "/etc/**": "ask",
            "*": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "question": "allow"
    },
    "mcp": {
        "docsgrep": {
            "type": "local",
            "command": ["npx", "-y", "@anovise/docsgrep"],
            "enabled": true
        },
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": ["php", "artisan", "boost:mcp"]
        },
        "github": {
            "type": "local",
            "command": ["bash", ".agents/mcp-github-wrapper.sh"],
            "enabled": false
        }
    },
    "agent": {}
}
