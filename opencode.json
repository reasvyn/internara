{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow",
            ".secrets": "deny",
            "**/.secrets": "deny",
            ".secrets/*": "deny",
            "**/.secrets/*": "deny"
        },
        "bash": {
            "*": "ask",
            "cat *secrets*": "deny",
            "cat *.env*": "deny",
            "cat *\\.env*": "deny",
            "grep *secrets*": "deny",
            "grep *\\.env*": "deny",
            "git *": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git branch*": "allow",
            "composer *": "allow",
            "php artisan *": "allow",
            "vendor/bin/pint *": "allow",
            "vendor/bin/pest *": "allow",
            "vendor/bin/phpstan *": "allow",
            "npm *": "allow",
            "npx prettier*": "allow",
            "python3 scripts/*": "allow",
            "ls *": "allow",
            "cat README.md": "allow",
            "cat AGENTS.md": "allow",
            "cat docs/*": "allow"
        },
        "skill": {
            "*": "allow"
        },
        "task": {
            "*": "allow"
        },
        "external_directory": {
            "~/.ssh/**": "ask",
            "/home/reasvyn/.ssh/**": "ask",
            "/tmp/**": "allow"
        }
    },
    "mcp": {
        "docsgrep": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@anovise/docsgrep"
            ],
            "enabled": true
        },
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "github": {
            "type": "local",
            "command": [
                "bash",
                ".agents/mcp-github-wrapper.sh"
            ],
            "enabled": false
        }
    },
    "agent": {
        "planner": {
            "description": "Planning specialist — spec-first & issue scoping (spec-writing, issue-writing). Owns docs/specs/*.md, FR/NFR/UC IDs, implementation-matrix, and GitHub issue drafting.",
            "permission": {
                "bash": {
                    "*": "ask",
                    "git *": "allow",
                    "git status*": "allow",
                    "git diff*": "allow",
                    "git log*": "allow",
                    "ls *": "allow",
                    "python3 scripts/scan_doc_links.py": "allow",
                    "python3 scripts/scan_violations.py": "allow"
                }
            }
        },
        "builder": {
            "description": "Implementation specialist — full 4-layer build (code-writing, code-refactoring, feature-building, laravel-best-practices, livewire-development, tailwindcss-development, medialibrary-development, pulse-development). Scaffolds Model→Entity→DTO→Action→Livewire→Policy per spec.",
            "permission": {
                "bash": {
                    "*": "ask",
                    "git *": "allow",
                    "composer *": "allow",
                    "php artisan *": "allow",
                    "vendor/bin/*": "allow",
                    "npm *": "allow",
                    "npx prettier*": "allow",
                    "python3 scripts/*": "allow"
                }
            }
        },
        "tester": {
            "description": "Testing specialist — spec-driven quality (pest-testing, test-writing). Owns tests/**/*.php, Pest suites, spec-gap/orphan detection, verification strategy. Example: pest-testing + test-writing → tester.",
            "permission": {
                "bash": {
                    "*": "ask",
                    "git *": "allow",
                    "composer *": "allow",
                    "php artisan test*": "allow",
                    "vendor/bin/pest *": "allow",
                    "vendor/bin/pint *": "allow",
                    "vendor/bin/phpstan *": "allow",
                    "python3 scripts/scan_*": "allow",
                    "npm *": "allow"
                }
            }
        },
        "reviewer": {
            "description": "Verification specialist — quality gates & audits (arch-guard, qa-protocol, security-audit, spec-audit). Runs C1-C8/D1-D6, OWASP/CWE, spec↔code sync; never writes code, only reports JSON + GitHub issues.",
            "permission": {
                "edit": "deny",
                "bash": {
                    "*": "ask",
                    "python3 scripts/scan_*": "allow",
                    "vendor/bin/pint *": "allow",
                    "vendor/bin/phpstan *": "allow",
                    "git status*": "allow",
                    "git diff*": "allow",
                    "git log*": "allow",
                    "ls *": "allow"
                }
            }
        },
        "scribe": {
            "description": "Documentation specialist — SSOT keeper (doc-writing, sync-docs). Owns docs/, docs/modules/*-reference.md, AGENTS.md, .agents/skills/*/SKILL.md, metadata Last updated, and link/ freshness checks.",
            "permission": {
                "bash": {
                    "*": "ask",
                    "git *": "allow",
                    "python3 scripts/scan_doc_links.py": "allow",
                    "python3 scripts/scan_violations.py": "allow",
                    "vendor/bin/pint *": "allow",
                    "ls *": "allow"
                }
            }
        },
        "automator": {
            "description": "Tooling specialist — script-automation for scripts/*. Owns devtools in scripts/, batch patterns, scan_*.py generators, output JSON reports, and Automation-First refactoring.",
            "permission": {
                "bash": {
                    "*": "ask",
                    "git *": "allow",
                    "python3 scripts/*": "allow",
                    "vendor/bin/pint *": "allow",
                    "ls *": "allow"
                }
            }
        },
        "deployer": {
            "description": "Deploy specialist — fast-forwards docker-deploy branch and monitors VPS health",
            "permission": {
                "bash": {
                    "*": "ask",
                    "git push *": "ask",
                    "ssh internara-vps *": "ask",
                    "git status*": "allow",
                    "git log*": "allow",
                    "git diff*": "allow"
                }
            }
        }
    }
}
